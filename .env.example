# 高德 JS API Key（仅用于浏览器定位 SDK，靠域名白名单保护，无法走后端代理）
VITE_AMAP_KEY=你的高德地图JS_API_Key

# 后端代理地址（Cloudflare Worker）
# Web 服务 Key / DeepSeek Key 只放在 Worker 的 Secret 里，不要填在前端这里。
# 部署 Worker 后，把它的 URL 填到下面两行。
VITE_AMAP_PROXY_URL=https://你的worker子域.workers.dev
VITE_LLM_PROXY_URL=https://你的worker子域.workers.dev

# Firebase 配置（用于多人协同功能，可选）
VITE_FIREBASE_API_KEY=你的Firebase_API密钥
VITE_FIREBASE_AUTH_DOMAIN=你的项目ID.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://你的项目ID.firebaseio.com
VITE_FIREBASE_PROJECT_ID=你的项目ID
VITE_FIREBASE_STORAGE_BUCKET=你的项目ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=你的发送者ID
VITE_FIREBASE_APP_ID=你的应用ID
